{
  "manifest_version": 3,
  "name": "DevPortfolio LeetCode Sync",
  "version": "1.0",
  "description": "Automatically syncs your accepted LeetCode submissions to your DevPortfolio in real-time.",
  "permissions": [
    "storage",
    "scripting",
    "tabs",
    "cookies"
  ],
  "host_permissions": [
    "https://leetcode.com/*",
    "http://localhost:4000/*",
    "http://localhost:5173/*"
  ],
  "background": {
    "service_worker": "background.js"
  },
  "content_scripts": [
    {
      "matches": ["https://leetcode.com/problems/*"],
      "js": ["content.js"],
      "run_at": "document_start"
    }
  ],
  "action": {
    "default_popup": "popup.html",
    "default_icon": {
      "16": "icons/icon16.png",
      "48": "icons/icon48.png",
      "128": "icons/icon128.png"
    }
  },
  "icons": {
    "16": "icons/icon16.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },
  "web_accessible_resources": [
    {
      "resources": ["inject.js"],
      "matches": ["https://leetcode.com/*"]
    }
  ]
}
